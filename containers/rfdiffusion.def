Bootstrap: docker
From: rosettacommons/rfdiffusion

# ---------------------------------------------------------------------------
# rfdiffusion-gui runtime image (Phase 1)
#
# Base: rosettacommons/rfdiffusion -- CUDA 11.6.2 / cuDNN 8 / Ubuntu 20.04 /
#       Python 3.9 / torch 1.12.1+cu116 / dgl 1.0.2+cu116 / e3nn 0.3.3 /
#       hydra-core 1.3.2 / SE3Transformer. A proven, fully pinned solve of the
#       hardest dependency problem in this project (R-1, R-2).
#
# WHY THE BASE IMAGE IS NOT ENOUGH
#   The base installs the RosettaCommons RFdiffusion package, which does NOT
#   support `inference.dump_pdb` / `inference.dump_pdb_path`. Those keys exist
#   only in the sokrypton fork (config/inference/base.yaml lines 22-23) and are
#   the entire mechanism behind per-step structure dumps -- so FR-16 (live step
#   progress) and FR-17 (live 3D preview) depend on the fork specifically.
#   We therefore clone the fork to /opt/RFdiffusion and put it on PYTHONPATH.
#   No name collision: the base installs a package called `rfdiffusion`; the
#   fork exposes top-level modules `inference`, `util`, `chemical`, ...
#
# GPU COVERAGE (verified against the live cluster, 2026-07-31)
#   CUDA 11.6 covers sm_37..sm_86, so this image runs on:
#     gpu, stamps-b, livi-b   (V100, sm_70)  -- 36 GPUs
#     agpu, mcordgpu-b        (A30,  sm_80)  -- 12 GPUs
#   It does NOT run on lgpu (L40s, sm_89) -- that needs the deferred Phase 2
#   CUDA 12.x image.
#
# APPLICATION SOURCE IS NOT BAKED IN
#   rfd-core and rfd-runner are bind-mounted at /opt/rfdgui (DD-2) so a Python
#   change never requires rebuilding a multi-GB image.
#
# Build:  scripts/build-image.sh
# Verify: scripts/verify-image.sh
# ---------------------------------------------------------------------------

%labels
    Maintainer   rfdiffusion-gui
    Phase        1
    BaseImage    rosettacommons/rfdiffusion
    CUDA         11.6.2
    Python       3.9
    Torch        1.12.1+cu116
    RFdiffusion  sokrypton/RFdiffusion@597d37f2a686e23941440fddf6daa4cb778e7bc7
    ColabDesign  sokrypton/ColabDesign@e31a56fe1d9b4de25c8697f3a28b75892941cc72
    JaxLib       0.4.7+cuda11.cudnn86 (CUDA build enforced by a build-time guard; §3 fallback tier 1 -- 0.4.25 required CUDA 11.8, this base is 11.6)
    GPUSupport   sm_70 (V100), sm_80 (A30) -- NOT sm_89 (L40s)

%post
    set -eux

    # -----------------------------------------------------------------------
    # NO apt-get HERE, DELIBERATELY.
    #
    # Singularity bind-mounts the host's /tmp (and /var/tmp) into the build
    # container. apt drops privileges to its sandbox user `_apt` (uid 100)
    # before fetching; under the --fakeroot UID mapping that identity is
    # unmapped on the host, so it cannot write there and the build dies with:
    #   Couldn't create temporary file /tmp/apt.conf.XXXXXX ... for apt-key
    #
    # We do not need apt anyway. The base image already ships git, curl, wget,
    # ca-certificates, build-essential and uv (confirmed from the registry
    # image config), and everything below uses only those.
    # -----------------------------------------------------------------------

    # Keep temp files inside the image rather than on a bind-mounted host
    # directory, so nothing here depends on host /tmp permissions -- uv
    # unpacks wheels via TMPDIR.
    mkdir -p /opt/buildtmp
    export TMPDIR=/opt/buildtmp

    # -----------------------------------------------------------------------
    # THE BASE IMAGE IS uv-BASED, NOT pip-BASED.
    #
    # The published rosettacommons/rfdiffusion image is NOT built from the
    # pip-based Dockerfile in that repo. Its actual build (read from the
    # registry image config) is:
    #     COPY /uv /uvx /bin/
    #     uv venv --python 3.9 && uv pip install dgl==1.0.2+cu116 torch==1.12.1+cu116 ...
    #     ENV PATH=/app/RFdiffusion/.venv/bin:...
    #
    # So `python3.9` resolves to /app/RFdiffusion/.venv/bin/python3.9, and that
    # venv has NO pip module -- uv does not install one by default. Every
    # install below must therefore go through uv, targeting that venv
    # explicitly.
    # -----------------------------------------------------------------------
    VENV=/app/RFdiffusion/.venv
    VPY="${VENV}/bin/python"

    command -v git >/dev/null || { echo "FATAL: git missing from base image"; exit 1; }
    command -v uv  >/dev/null || { echo "FATAL: uv missing from base image"; exit 1; }
    test -x "$VPY" || { echo "FATAL: expected venv interpreter at $VPY"; exit 1; }

    # -----------------------------------------------------------------------
    # sokrypton fork -- REQUIRED for inference.dump_pdb (FR-16, FR-17).
    # Pinned to an explicit commit; the notebook left this floating (TD-19).
    # -----------------------------------------------------------------------
    RFD_SHA=597d37f2a686e23941440fddf6daa4cb778e7bc7
    git clone https://github.com/sokrypton/RFdiffusion.git /opt/RFdiffusion
    git -C /opt/RFdiffusion checkout "${RFD_SHA}"
    git -C /opt/RFdiffusion rev-parse HEAD > /opt/RFdiffusion.sha

    # Fail the BUILD, not a job three hours from now, if the fork ever loses
    # the keys the live-progress feature depends on.
    grep -q 'dump_pdb:'      /opt/RFdiffusion/config/inference/base.yaml
    grep -q 'dump_pdb_path:' /opt/RFdiffusion/config/inference/base.yaml

    # -----------------------------------------------------------------------
    # THE FORK NEEDS TWO PACKAGES THE BASE IMAGE DOES NOT INSTALL.
    #
    # reference/diffusion.py cell 2 (commented out, never executed by the
    # exported script) did `pip install jedi omegaconf hydra-core icecream
    # pyrsistent pynvml decorator` -- a Colab convenience cell installing
    # everything the fork *might* touch, onto a base with no pins of its own.
    # The RosettaCommons image's install list was built for RosettaCommons's
    # own codebase, which does not import any of these, so none of them ship.
    #
    # Determined which are ACTUALLY required by fetching the fork source at
    # the pinned commit and reading every import, rather than installing the
    # whole Colab cell defensively:
    #   icecream   -- REQUIRED. Imported unconditionally by run_inference.py
    #                 (the entry point), diff_util.py, contigs.py,
    #                 potentials/manager.py, RoseTTAFoldModel.py, Embeddings.py.
    #                 Missing it fails before any real work starts.
    #   pyrsistent -- REQUIRED. `from pyrsistent import v` in
    #                 inference/symmetry.py -- this project's symmetry feature
    #                 (rfd_core.symmetry, U2b SymmetryDetection) depends on it.
    #   jedi       -- NOT needed. Zero references anywhere in the fork; it was
    #                 only ever Colab's interactive tab-completion.
    #   pynvml, decorator -- NOT needed for inference. Both are real deps of
    #                 env/SE3Transformer/requirements.txt, but that file is
    #                 decorative -- SE3Transformer's setup.py declares no
    #                 install_requires. Both packages are imported only by
    #                 se3_transformer.runtime.{training,inference}, NVIDIA's
    #                 own training/benchmark harness; RFdiffusion imports only
    #                 se3_transformer.model (SE3_network.py), never .runtime.
    #                 Confirmed by grepping the full fork tree at the pinned
    #                 commit -- adding them would be unused weight.
    #   omegaconf, hydra-core -- already pinned by the base image.
    # -----------------------------------------------------------------------
    uv pip install --python "$VPY" --no-cache "icecream" "pyrsistent"

    # -----------------------------------------------------------------------
    # JAX for ColabDesign (ProteinMPNN + AlphaFold).
    #
    # §3 FALLBACK TIER 1 IS NOW ACTIVE (as of 2026-08-06 -- see
    # infrastructure-design.md §8.1g). The originally-attempted
    # jaxlib==0.4.25+cuda11.cudnn86 FAILED on a real GPU allocation:
    #   "Found CUDA version 11060, but JAX was built against version 11080,
    #   which is newer. The copy of CUDA that is installed must be at least
    #   as new as the version against which JAX was built."
    # i.e. CUDA's forward-compat model requires runtime >= build version, and
    # this base image's runtime is CUDA 11.6.2 -- older than 11.8.
    #
    # Root-caused via JAX's own CHANGELOG.md rather than guessed: "## jax
    # 0.4.8 (March 29, 2023)" is the exact release where "CUDA 11.4 support
    # has been dropped. JAX GPU wheels only support CUDA 11.8 and CUDA 12."
    # Every cuda11-tagged jaxlib from 0.4.8 onward -- including 0.4.25 -- is
    # therefore built against CUDA 11.8 regardless of what its cudnnXX suffix
    # says. jaxlib 0.4.7 is the NEWEST cuda11 build that predates this bump,
    # confirmed against the full wheel index at jax_cuda_releases.html.
    #
    # jaxlib still needs cuDNN >= 8.6, which the base image's 8.4-era runtime
    # does not provide -- hence the pip-supplied cuDNN below, unchanged from
    # the original attempt and unrelated to the CUDA-version problem above.
    # -----------------------------------------------------------------------
    uv pip install --python "$VPY" --no-cache "nvidia-cudnn-cu11==8.6.0.163"

    # ONE resolution pass for jax AND everything that depends on it.
    #
    # Installing the extras separately does not work: chex/optax/dm-haiku pull
    # a newer jax, and uv then REPLACES a pinned jaxlib with a generic CPU-only
    # wheel. The build still "succeeds" and silently produces an image where
    # JAX has no GPU. Resolving everything together forces any incompatibility
    # to surface as a loud conflict here instead.
    #
    # Extras re-verified (via PyPI requires-dist history, not assumption) for
    # jax==0.4.7 specifically -- the versions pinned for jax 0.4.25 do NOT
    # carry over unchanged:
    #   chex   -- 0.1.86 needs jax>=0.4.16, which 0.4.7 VIOLATES. chex bumped
    #             that floor to 0.4.16 in 0.1.83 (2023-09-20); 0.1.82
    #             (2023-07-20) is the newest release still requiring only
    #             jax>=0.4.6, so it is pinned here instead.
    #   optax  -- FIRST ATTEMPT WRONG: checked only optax==0.2.2's jax bound
    #             (jax>=0.1.55, fine) and missed that it ALSO requires
    #             chex>=0.1.86 unconditionally -- a direct conflict with the
    #             chex==0.1.82 pin above, caught by `uv`'s own resolver as a
    #             loud failure at build time (exactly what "one resolution
    #             pass" exists to do). optax 0.1.7 (2023-07-26, contemporary
    #             with chex 0.1.82) requires only chex>=0.1.5 and jax>=0.1.55
    #             -- pinned here instead.
    #   dm-haiku -- ORIGINALLY 0.0.12, changed to 0.0.10 after Milestone M1's
    #             first real GPU execution (2026-08-13) hit a live
    #             ModuleNotFoundError, past pip resolution entirely -- pip's
    #             version bounds are necessary, not sufficient, exactly the
    #             lesson from the jaxlib wheel-tag saga above applied to a
    #             different failure mode. `haiku/_src/dot.py` (imported
    #             unconditionally by `import haiku`, via
    #             `haiku/experimental/__init__.py`) does
    #             `from jax.extend import linear_util as lu` in 0.0.12. The
    #             `jax.extend` namespace ITSELF did not exist until jax
    #             0.4.16 (traced via GitHub commit ca39457ea9, "move
    #             jax.linear_util to jax.extend.linear_util", landing
    #             2023-08-30, just after the 0.4.15 release) -- jax==0.4.7 is
    #             months too old to have it, and cannot be bumped without
    #             breaking the CUDA-11.6-vs-11.8 ceiling this file already
    #             documents above. So no dm-haiku release contemporary with
    #             jax>=0.4.16 can work here; the fix has to go the other way.
    #             Fetched haiku's own release history: 0.0.10 (2023-07-14)
    #             predates the jax.extend commit itself, so its dot.py cannot
    #             reference it -- confirmed by reading
    #             haiku/_src/dot.py at the v0.0.10 tag directly, which uses
    #             the plain `jax.linear_util` attribute (still present on
    #             jax==0.4.7; the module was only MOVED to jax.extend, not
    #             removed from top-level jax until much later). 0.0.10's own
    #             optional [jax] extra wants jax>=0.4.13 (not enforced here --
    #             this install does not request that extra) and it declares
    #             no unconditional flax dependency (only 0.0.11+ do), so no
    #             cascading conflict. ColabDesign's own setup.py pins no
    #             dm-haiku version at all (--no-deps below anyway).
    #
    # ml-collections / biopython / dm-tree / pandas / scipy / matplotlib --
    # found missing live on Milestone M1's third real GPU execution
    # (2026-08-13): ColabDesign is installed --no-deps (below), so NONE of
    # its own install_requires were ever pulled in automatically. The first
    # of these to be hit (colabdesign.af.alphafold.model.config imports
    # ml_collections) surfaced as a `ModuleNotFoundError` past two other
    # already-fixed ones (pydantic, jax.extend) -- rather than fix these one
    # import at a time across further cluster round trips, fetched
    # ColabDesign's setup.py install_requires directly (already done once
    # for the dm-haiku investigation above) and diffed it against everything
    # already installed in this file: absl-py and numpy are already pulled
    # in transitively by dm-haiku/chex/optax (no --no-deps on this command),
    # leaving ml-collections, biopython, dm-tree, pandas, scipy, and
    # matplotlib as the genuine gap. Added all six here, in the SAME
    # resolution pass, rather than a separate later `uv pip install` --
    # consistent with this section's own stated principle (a later separate
    # install could silently upgrade something already resolved here).
    #
    # numpy<2 pin: dry-run resolving these six alongside the jax/jaxlib pins
    # above (without them, i.e. an unconstrained equivalent) picked
    # numpy==2.0.2 -- NumPy 2.0 broke ABI compatibility for C extensions
    # built against the 1.x API, which is exactly what a March-2023
    # `jaxlib==0.4.7` wheel is. The already-VERIFIED PASS-13 GPU run
    # (2026-08-07) proves the base image's pre-existing numpy (from the
    # already-baked-in torch/dgl/e3nn stack) is safely <2 -- this pin makes
    # that an enforced constraint instead of an accident of installation
    # order, so a future package addition here fails loudly at build time
    # instead of silently crossing the ABI boundary. Confirmed compatible
    # with scipy 1.13.1 (numpy<2.3,>=1.22.4), pandas 2.3.3 (numpy>=1.22.4
    # for Python<3.11, which this image is), and matplotlib 3.9.4
    # (numpy>=1.23) via their own PyPI requires_dist -- a dry-run resolve of
    # this exact set (jax/jaxlib pinned, numpy<2 pinned) picks numpy==1.26.4
    # with no conflicts.
    uv pip install --python "$VPY" --no-cache \
        "jax==0.4.7" \
        "jaxlib==0.4.7+cuda11.cudnn86" \
        "opt_einsum_fx" \
        "py3Dmol" "joblib" "immutabledict" \
        "chex==0.1.82" "optax==0.1.7" "dm-haiku==0.0.10" \
        "numpy>=1.23,<2" "ml-collections" "biopython" "dm-tree" "pandas" "scipy" "matplotlib" \
        -f https://storage.googleapis.com/jax-releases/jax_cuda_releases.html

    # ColabDesign last, with --no-deps, so it cannot perturb the set above.
    CD_SHA=e31a56fe1d9b4de25c8697f3a28b75892941cc72
    uv pip install --python "$VPY" --no-cache --no-deps \
        "git+https://github.com/sokrypton/ColabDesign.git@${CD_SHA}"

    echo "${CD_SHA}" > /opt/ColabDesign.sha

    # -----------------------------------------------------------------------
    # HARD GUARD: fail the BUILD if jaxlib is not the CUDA build.
    #
    # This is the assertion that would have caught the clobbering above. A
    # CUDA jaxlib reports a local version like "0.4.7+cuda11.cudnn86"; a
    # CPU wheel reports a bare version with no "+cuda..." suffix at all.
    # Without this check the image builds fine and the problem only appears
    # later as "JAX sees no GPU". NOTE: this guard checks for a CUDA BUILD,
    # not a working one -- it would not have caught the CUDA-11.6-vs-11.8
    # runtime mismatch below, since that jaxlib genuinely was a CUDA build,
    # just one requiring a newer CUDA than this base image provides. That
    # failure mode can only be caught by an actual GPU run (verify-image.sh
    # checks 1/2/4, which is why they exist).
    # -----------------------------------------------------------------------
    "$VPY" - <<'GUARD'
from importlib.metadata import version
v = version("jaxlib")
print("jaxlib installed version:", v)
if "cuda" not in v:
    raise SystemExit(
        f"FATAL: jaxlib is '{v}', not a CUDA build. Something in the dependency "
        "set replaced the pinned +cuda11.cudnn86 wheel. Do not ship this image."
    )
print("OK: jaxlib is a CUDA build")
GUARD

    # -----------------------------------------------------------------------
    # rfd-core / rfd-runner's OWN runtime dependency.
    #
    # DD-2 (application-design.md): rfd-core and rfd-runner source is
    # bind-mounted into the container at run time (/opt/rfdgui), not
    # installed here -- only their dependencies belong in the image. This
    # project's own packages did not exist yet when this file was first
    # written, so their one dependency (rfd-core/pyproject.toml:
    # pydantic>=2.0,<3) was never added -- found live on Milestone M1's
    # first real Grex GPU execution (2026-08-13):
    #   ModuleNotFoundError: No module named 'pydantic'
    # (rfd_runner -> rfd_core -> rfd_core.models -> pydantic, at import).
    # No interaction with the jax/torch dependency sets above -- installed as
    # its own independent resolution, exactly matching rfd-core's own pin so
    # a future rfd-core dependency bump cannot silently drift from the image.
    # -----------------------------------------------------------------------
    uv pip install --python "$VPY" --no-cache "pydantic>=2.0,<3"

    # -----------------------------------------------------------------------
    # MODEL CHECKPOINTS ARE ALREADY IN THE BASE IMAGE.
    #
    # The published image bakes in all nine RFdiffusion checkpoints under
    # /app/RFdiffusion/models -- including the three this project uses
    # (Base_ckpt.pt, Complex_base_ckpt.pt, Complex_beta_ckpt.pt). That is what
    # the 5.6 GiB layer is.
    #
    # The fork resolves checkpoints as {SCRIPT_DIR}/../models/*.pt, i.e.
    # /opt/RFdiffusion/models -- so a symlink is all that is needed, and
    # stage-weights.sh no longer downloads them at all (~4 GB saved).
    # -----------------------------------------------------------------------
    test -f /app/RFdiffusion/models/Base_ckpt.pt || \
        { echo "FATAL: base image no longer ships model checkpoints"; exit 1; }
    ln -s /app/RFdiffusion/models /opt/RFdiffusion/models

    # -----------------------------------------------------------------------
    # DIFFUSION SCHEDULES.
    #
    # The fork caches schedules in {SCRIPT_DIR}/../schedules, creating that
    # directory at import and WRITING to it whenever a requested T is not
    # already cached. A SIF is read-only at run time, so the directory must
    # live on writable scratch -- hence the symlink onto /scratch, which the
    # job binds from $TMPDIR.
    #
    # NO PRE-SEEDING. The notebook downloaded schedules.zip from
    # files.ipd.uw.edu/krypton/schedules.zip, but that URL now returns 404 --
    # verified 2026-08-01. It was only ever an optimisation: the Diffuser
    # computes any missing schedule and caches it. The cost is a one-time
    # generation per distinct T value, on CPU, at the start of a run.
    #
    # U2b requirement: the runner must `mkdir -p /scratch/schedules` before
    # invoking run_inference.py. The fork calls os.mkdir() on this path, which
    # raises FileExistsError on a dangling symlink.
    # -----------------------------------------------------------------------
    ln -s /scratch/schedules /opt/RFdiffusion/schedules

    mkdir -p /opt/rfdgui /opt/weights /opt/outputs /scratch

    # Build scratch cleanup.
    rm -rf /opt/buildtmp

%environment
    export DGLBACKEND=pytorch
    export PYTHONNOUSERSITE=1

    # cuDNN 8.6 supplied by pip must be found ahead of the base image's 8.4.0.27.
    # NOTE the path: packages live in the image's uv venv, NOT in dist-packages.
    export LD_LIBRARY_PATH=/app/RFdiffusion/.venv/lib/python3.9/site-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH:-}

    # Bind-mounted application source (DD-2) plus the sokrypton fork.
    export PYTHONPATH=/opt/rfdgui/packages/rfd-core/src:/opt/rfdgui/packages/rfd-runner/src:/opt/RFdiffusion:${PYTHONPATH:-}

    export RFD_FORK=/opt/RFdiffusion
    # Checkpoints come from the base image (symlinked into the fork), not from
    # the staged weights directory.
    export RFD_MODELS=/opt/RFdiffusion/models
    export RFD_AF_PARAMS=/opt/weights/alphafold
    export ANANAS_BIN=/opt/weights/bin/ananas

    # JAX must not preallocate the GPU -- torch runs in a sibling subprocess.
    export XLA_PYTHON_CLIENT_PREALLOCATE=false

%runscript
    exec /app/RFdiffusion/.venv/bin/python -m rfd_runner "$@"

%test
    set -e
    PY=/app/RFdiffusion/.venv/bin/python
    echo "== python"         && $PY -V
    echo "== torch"          && $PY -c "import torch; print(torch.__version__)"
    echo "== dgl / e3nn"     && $PY -c "import dgl, e3nn; print(dgl.__version__, e3nn.__version__)"
    echo "== fork present"   && test -f /opt/RFdiffusion/run_inference.py
    echo "== dump_pdb keys"  && grep -c 'dump_pdb' /opt/RFdiffusion/config/inference/base.yaml
    echo "== checkpoints"    && ls /opt/RFdiffusion/models/Base_ckpt.pt \
                                   /opt/RFdiffusion/models/Complex_base_ckpt.pt \
                                   /opt/RFdiffusion/models/Complex_beta_ckpt.pt
    echo "== jax import"     && $PY -c "import jax; print(jax.__version__)"
