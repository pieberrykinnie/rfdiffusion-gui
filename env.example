# rfdiffusion-gui configuration.
# Copy to .env and edit as needed:  cp env.example .env
#
# Every path defaults to /home. Moving any of them to /project is a change here,
# not a change to code (NFR-6).

# --- Paths -----------------------------------------------------------------
# Repository root; bind-mounted into the container at /opt/rfdgui.
# If you cloned into /project space, point this there -- e.g.
#   RFD_PROJECT_ROOT="$HOME/projects/def-cardona/$USER/rfdiffusion-gui"
# scripts/build-image.sh prints the correct value when it finishes.
RFD_PROJECT_ROOT="$HOME/rfdiffusion-gui"

# Model weights (~8 GB, ~4 GB with --no-multimer); bound at /opt/weights.
# /home has a 100 GB quota; /project has 5 TB per group. If you already have
# project space, putting weights and outputs there is the easier long-term
# choice -- e.g. "$HOME/projects/def-cardona/$USER/rfd-weights".
# Keep RFD_DB on /home regardless: SQLite locking behaves badly on Lustre.
RFD_WEIGHTS="$HOME/rfd-weights"

# Container image
RFD_IMAGE="$HOME/rfd-images/rfdiffusion.sif"

# Per-run output directories; bound at /opt/outputs
RFD_OUTPUT_ROOT="$HOME/rfd-runs"

# SQLite run index. Keep on /home -- SQLite locking behaves badly on Lustre.
RFD_DB="$HOME/.local/share/rfdgui/runs.sqlite"

# Apptainer cache. Set explicitly (G-18): left at its default it grows silently
# and eats the 100 GB /home quota at the worst possible moment.
APPTAINER_CACHEDIR="$HOME/.cache/apptainer"
SINGULARITY_CACHEDIR="$HOME/.cache/apptainer"

# --- Slurm defaults --------------------------------------------------------
# Verified on Grex 2026-07-31. The Phase 1 (CUDA 11.6) image runs on:
#   gpu, stamps-b, livi-b   V100, sm_70   (36 GPUs)
#   agpu, mcordgpu-b        A30,  sm_80   (12 GPUs)
# It does NOT run on lgpu (L40s, sm_89) -- that needs the Phase 2 image.
RFD_DEFAULT_PARTITION="gpu"

# Your accounting group. Leave unset to omit --account entirely.
RFD_DEFAULT_ACCOUNT="def-cardona"

# Defaults follow Grex's own GPU guidance: start with one GPU, 6 CPUs per GPU,
# 4-8 GB RAM per CPU (G-7, G-8).
RFD_DEFAULT_GPUS="1"
RFD_DEFAULT_CPUS_PER_TASK="6"
RFD_DEFAULT_MEM_PER_CPU="6000M"

# Always explicit -- Grex defaults to only 3 hours (G-4).
RFD_DEFAULT_WALLTIME="0-08:00:00"

# --- Web app ---------------------------------------------------------------
# Bind to localhost only; the SSH tunnel is the security boundary (NFR-14).
RFD_BIND_HOST="127.0.0.1"
RFD_BIND_PORT="8080"

# --- Slurm client and status tracking (U3) ---------------------------------
# How often the browser re-asks for a run's status, in SECONDS. The notebook polled the
# filesystem at 10 Hz; Grex's controller is shared infrastructure, so this is measured in
# seconds and a finished run is never re-queried at all (NFR-16).
RFD_STATUS_POLL_SECONDS="5"

# Hard timeout on every squeue/sacct/sinfo/sbatch/scancel call. The web app lives on a
# shared login node, and an unbounded sacct against a wedged controller would pin a
# worker indefinitely (NFR-15).
RFD_SLURM_TIMEOUT_SECONDS="30"

# How long discovered partitions are cached. Partition topology changes on the scale of
# cluster maintenance, not page loads.
RFD_PARTITION_CACHE_SECONDS="300"

# Age past which progress.json is treated as stale, in seconds. Note this is EXPECTED
# during the validation stage: the runner only reports steps during backbone generation,
# so progress.json legitimately freezes once that ends. The UI says "validating" rather
# than showing a stalled bar.
RFD_PROGRESS_STALE_SECONDS="120"

# Partitions the CURRENT image cannot run on, comma-separated. This is a property of the
# image, not of the cluster: partitions themselves are always discovered at runtime via
# sinfo and never hard-coded (FR-6a). Listed partitions are still shown and selectable,
# just flagged -- swap the image and this line, not the code.
#   Phase 1 (CUDA 11.6) runs on gpu, stamps-b, livi-b (V100 sm_70) and agpu,
#   mcordgpu-b (A30 sm_80). It does NOT run on lgpu (L40s, sm_89).
RFD_INCOMPATIBLE_PARTITIONS="lgpu"

# Lines of job log attached to a failed run (FR-19). The tail is read from job-*.err
# first, falling back to job-*.out when the former is empty.
RFD_LOG_TAIL_LINES="50"

# --- Optional: AnAnaS symmetry detector ------------------------------------
# Powers symmetry="auto" ONLY. Every other symmetry mode (none / cyclic /
# dihedral with an explicit order) works without it.
#
# The URL the original notebook used is dead -- files.ipd.uw.edu/krypton/ was
# removed upstream (404, verified 2026-08-01). If you obtain the binary from
# https://team.inria.fr/nano-d/software/ananas/ you can either drop it at
# $RFD_WEIGHTS/bin/ananas (chmod +x) or point this at a URL you control.
#RFD_ANANAS_URL="https://example.org/ananas"

# --- Live progress ---------------------------------------------------------
# Publish the current structure frame every N denoising steps (DD-3).
# The step counter still updates every step, so the progress bar stays smooth.
RFD_FRAME_EVERY_N="5"

# --- Runner (U2b) ------------------------------------------------------------
# Per-step stall timeout, in seconds. Slurm's own --time is already a hard backstop;
# this exists so a hung step is caught and reported quickly, with the specific step
# number, instead of the user waiting out the full walltime for a bare TIMEOUT.
RFD_STEP_TIMEOUT_SECONDS="1800"

# How often the runner polls for the next step's dump, in milliseconds. Matches the
# original notebook's cadence (time.sleep(0.1)).
RFD_POLL_INTERVAL_MS="100"
